# ===== TeleGravity Configuration Template =====
# Copy this file to .env and fill in your values.

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Telegram Chat ID(s) (send /start to get it)
# For multiple users, separate with commas: 123456,789012
ALLOWED_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# CDP Debugging Port (must match IDE launch args, default is 9223)
AGENT_CDP_PORT=9223

# Default AI model to select on new chat / IDE startup (optional)
DEFAULT_MODEL=Gemini 3.5 Flash (High)

# Language (optional, default is en)
LANGUAGE=en

# ===== Antigravity Dual App Configuration =====
# Preferred active application target: 'agent' (standalone Antigravity) or 'ide' (Antigravity IDE)
ANTIGRAVITY_PREFERRED_APP=agent

# Enable auto-accept module by default when the bot starts
AUTOACCEPT_DEFAULT=true
